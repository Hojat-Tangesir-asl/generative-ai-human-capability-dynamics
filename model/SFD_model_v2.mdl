{UTF-8}
Human Capability= INTEG (
	HC Development-HC Erosion,
		0.5)
	~	Dmnl
	~		|

AI Capability= INTEG (
	AIC Development-AIC Obsolescence,
		0.1)
	~	Dmnl
	~		|

AI Dependency= INTEG (
	Dependency Formation-Dependency Reduction,
		0.2)
	~	Dmnl
	~		|

Organizational Learning Capacity= INTEG (
	OLC Development-OLC Loss,
		0.1)
	~	Dmnl
	~		|

HC Development=
	(0.3*Creativity +0.3*Human Skills +0.4*Organizational Learning Capacity/Adjustment Time\
		)*MAX(0,1-Human Capability)
	~	1/year
	~	FIX-1 Time->Adjustment Time; FIX-5 capability ceiling
	|

HC Erosion=
	Human–AI Task Allocation*Human Capability/Adjustment Time
	~	1/year
	~	FIX-1
	|

Dependency Formation=
	0.7*(0.3*AI Utilization Intensity+0.4*Cognitive Offloading+0.35*Human Capability Gap\
		)*MAX(0,1-AI Dependency)/Adjustment Time
	~	1/year
	~	FIX-1; FIX-2 saturation
	|

Dependency Reduction=
	0.7*AI Dependency*(0.25*"Independent Problem-Solving Ability"/Adjustment Time+0.25*Independent Practice\
		+0.2*(1-Human–AI Task Allocation)/Adjustment Time+0.3*HC Development)
	~	1/year
	~	FIX-1; FIX-3 retained (human) task share
	|

OLC Development=
	Organizational Learning*"Training / Capability Investment"
	~	1/year
	~		|

OLC Loss=
	Organizational Learning Capacity/CF4
	~	1/year
	~	CF4 is now the OLC forgetting time
	|

AIC Development=
	Organizational Learning Capacity/AI Development Time
	~	1/year
	~	FIX-4
	|

AIC Obsolescence=
	AI Capability/AI Obsolescence Time
	~	1/year
	~	FIX-4
	|

Productivity=
	Human–AI Complementarity+Human Capability+AI Performance
	~	Dmnl
	~		|

AI Performance=
	0.3*AI Capability
	~	Dmnl
	~		|

AI Adoption=
	Adoption Coefficient*Productivity
	~	Dmnl
	~	0.3 -> scenario lever
	|

AI Controllability Gap=
	0.3*AI Decision Autonomy
	~	Dmnl
	~		|

AI Decision Autonomy=
	0.3*AI Capability
	~	Dmnl
	~		|

AI Safety Risk=
	0.3*AI Controllability Gap
	~	Dmnl
	~		|

AI Utilization Intensity=
	MIN(1,0.6* AI Adoption + 0.4* AI Dependency)
	~	Dmnl
	~		|

Available Learning Time=
	0.3*Workload Reduction
	~	Dmnl
	~		|

Cognitive Engagement=
	0.5*(1-Cognitive Offloading)
	~	Dmnl
	~	FIX-6 engagement falls with offloading
	|

Cognitive Offloading=
	0.3*AI Adoption+0.2*AI Utilization Intensity+0.5*Human–AI Task Allocation
	~	Dmnl
	~		|

Creativity=
	CF2*Organizational Learning*Cognitive Engagement
	~	1/year
	~		|

Human Capability Gap=
	MAX(0, 1-(Human Capability)/(Required Human Capability))
	~	Dmnl
	~		|

Human Skills=
	Organizational Learning*"Training / Capability Investment"+Independent Practice
	~	1/year
	~		|

Human–AI Complementarity=
	0.3*AI Capability+0.3*Human Capability+0.4*Human–AI Task Allocation
	~	Dmnl
	~		|

"Independent Problem-Solving Ability"=
	0.3*Human Capability
	~	Dmnl
	~		|

Independent Practice=
	Practice Policy*MAX(0, MIN(1, 0.4* (1 - AI Dependency) + 0.35* Cognitive Engagement)\
		)/Adjustment Time
	~	1/year
	~	FIX-1; Practice Policy = scenario lever
	|

Workload Reduction=
	0.3*Repetitive Task Automation
	~	Dmnl
	~		|

Learning Opportunities=
	0.3*Available Learning Time
	~	Dmnl
	~		|

Organizational Failure Risk=
	AI Dependency+AI Safety Risk-Human Capability
	~	Dmnl
	~		|

Organizational Learning=
	Learning Opportunities/CF3
	~	1/dolar
	~		|

Perceived Capability Risk=
	0.3*AI Dependency*CF1
	~	dolar/year
	~		|

Repetitive Task Automation=
	AI Adoption*Human–AI Task Allocation
	~	Dmnl
	~		|

"Training / Capability Investment"=
	Perceived Capability Risk*Training Rate
	~	dolar/year
	~	0.2 -> scenario lever
	|

CF1=
	1
	~	dolar/year
	~		|

CF2=
	1
	~	dolar/year
	~		|

CF3=
	0.002
	~	dolar
	~	FIX-7 calibration: 1/CF3 = 500 (learning-chain gain)
	|

CF4=
	5
	~	year
	~	OLC forgetting time
	|

Adjustment Time=
	1
	~	year
	~	FIX-1 replaces the built-in Time in rate equations
	|

AI Obsolescence Time=
	3
	~	year
	~		|

Required Human Capability=
	0.7
	~	Dmnl
	~		|

Scenario=
	5
	~	Dmnl
	~	scenario selector 0...5
	|

Correction Time=
	10
	~	year
	~		|

Before Correction=
	IF THEN ELSE(Scenario=3 :AND: Time>=Correction Time, 0, 1)
	~	Dmnl
	~	1 until the policy switch in scenario 3
	|

Human–AI Task Allocation=
	IF THEN ELSE(Scenario=2 :OR: Scenario=3, IF THEN ELSE(Before Correction=1, 0.2+0.4*MIN\
		(1,Time/5), 0.2), IF THEN ELSE(Scenario=4, 0.2+0.3*MIN(1,Time/5), 0.2))
	~	Dmnl
	~		|

Adoption Coefficient=
	IF THEN ELSE(Scenario=2 :OR: (Scenario=3 :AND: Before Correction=1), 0.45, 0.3)
	~	Dmnl
	~		|

Training Rate=
	IF THEN ELSE(Scenario=1, 0.4, IF THEN ELSE(Scenario=2, 0.1, IF THEN ELSE(Scenario=3,\
		 IF THEN ELSE(Before Correction=1, 0.1, 0.4), 0.2)))
	~	Dmnl
	~		|

Practice Policy=
	IF THEN ELSE(Scenario=1, 1.5, IF THEN ELSE(Scenario=2, 0.5, IF THEN ELSE(Scenario=3,\
		 IF THEN ELSE(Before Correction=1, 0.5, 1.5), 1)))
	~	Dmnl
	~		|

AI Development Time=
	IF THEN ELSE(Scenario=5, 1.5, 3)
	~	year
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 30
	~	year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	year
	~	The initial time for the simulation.
	|

SAVEPER  =
        0.25
	~	year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0625
	~	year [0,?]
	~	The time step for the simulation.
	|

